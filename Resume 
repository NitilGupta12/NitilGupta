<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Nitil Gupta — Portfolio</title>
  <meta name="description" content="Portfolio of Nitil Gupta — BCA Student · MERN Intern · Python & Java Developer">
  <style>
    :root {
      --bg: #0f1724;
      --card: #0b1220;
      --muted: #9aa4b2;
      --accent: #6ee7b7;
      --glass: rgba(255,255,255,0.03);
      --glass-2: rgba(255,255,255,0.02);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui;
      background: linear-gradient(180deg, #0c1220, #0a1426 35%, #071021 80%);
      color: #e6eef6;
      line-height: 1.65;
    }
    .container { max-width: 1100px; margin: 36px auto; padding: 28px; }

    header { display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; gap: 16px; align-items: center; }
    .logo-monogram {
      font-size: 1.9rem; font-weight: 700; padding: 10px 18px;
      border-radius: 14px; background: linear-gradient(130deg, var(--accent), #60a5fa);
      color: #041e22; box-shadow: 0 4px 16px rgba(0,0,0,0.25);
    }
    h1 { font-size: clamp(1.6rem, 2.6vw, 2.6rem); margin: 0; font-weight: 600; }
    .lead { color: var(--muted); margin: 6px 0 0; }
    nav a { color: var(--muted); text-decoration: none; margin-left: 18px; font-size: 0.95rem; }
    nav a:hover { color: var(--accent); }

    main { display: grid; grid-template-columns: 1fr 360px; gap: 28px; margin-top: 28px; }
    .card {
      background: var(--card);
      padding: 20px; border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.05);
      box-shadow: 0 4px 16px rgba(0,0,0,0.35);
    }
    .accent-border { border-left: 4px solid var(--accent); }

    .fade-in { opacity: 0; transform: translateY(14px); animation: fadeinFormal 0.7s forwards ease-out; }
    @keyframes fadeinFormal { to { opacity: 1; transform: none; } }
    .lift:hover { transform: translateY(-4px); transition: 0.28s ease-out; }

    .hero { padding: 24px; border-radius: 14px; background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); display: flex; gap: 24px; align-items: center; }

    .cta { display: flex; gap: 12px; margin-top: 18px; }
    .btn {
      padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.04);
      background: transparent; color: inherit; cursor: pointer; font-size: 0.92rem; font-weight: 500;
    }
    .btn.primary {
      background: linear-gradient(90deg, var(--accent), #60a5fa);
      color: #042022; border: none; font-weight: 600;
    }

    .projects { display: grid; gap: 12px; }
    .project {
      padding: 14px; border-radius: 10px; background: var(--glass-2);
    }
    .project h3 { margin: 0 0 6px 0; font-size: 1.1rem; }

    .timeline { display: flex; flex-direction: column; gap: 12px; }
    .timeline-item {
      padding: 12px; border-radius: 10px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.03);
    }

    .skills-matrix { display: grid; grid-template-columns: repeat(2,1fr); gap: 14px; }
    .skill-box {
      background: rgba(255,255,255,0.04); padding: 14px; border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.06);
    }

    .tech-ribbon { display: flex; flex-wrap: wrap; gap: 10px; }
    .tech-tag {
      padding: 6px 14px; border-radius: 20px; background: rgba(255,255,255,0.04);
      font-size: 0.85rem; border: 1px solid rgba(255,255,255,0.05);
    }

    .socials { display: flex; gap: 12px; margin: 22px 0; }
    .social-btn {
      padding: 8px 14px; border-radius: 10px; background: var(--glass);
      border: 1px solid rgba(255,255,255,0.06); text-decoration: none;
      color: #e6eef6; font-size: 0.9rem;
    }
    .social-btn:hover { background: var(--accent); color: #042022; }

    footer {
      margin-top: 34px; padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.07);
      text-align: center; color: var(--muted); font-size: 0.92rem;
    }

    @media (max-width: 980px) {
      main { grid-template-columns: 1fr; }
      .hero { flex-direction: column; text-align: center; }
      .cta { justify-content: center; }
    }
  </style>
</head>
<body>
